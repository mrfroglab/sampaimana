# Salin ke /opt/stacks/apps/sampaimana/backup.env, lalu chmod 600. Jangan di-commit yang asli.

# Tujuan salinan di luar server (remote rclone). Kosong = hanya salinan lokal.
# Sangat disarankan remote bertipe "crypt" supaya dump (berisi email & hash sandi) terenkripsi sebelum diunggah.
# Contoh: BACKUP_REMOTE=gdrive-crypt:sampaimana
BACKUP_REMOTE=

# Notifikasi saat backup gagal. Isi salah satu URL:
#   ntfy:     https://ntfy.sh/<topik-rahasia-anda>   (atau ntfy self-hosted)
#   Discord:  https://discord.com/api/webhooks/<id>/<token>
#   Slack:    https://hooks.slack.com/services/...
BACKUP_NOTIFY_URL=

KEEP_DAILY=7
KEEP_WEEKLY=4
